{
  "name": "plasticity-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "npm run test:web && npm run test:server",
    "test:web": "vitest run",
    "test:server": "node --test test/server/*.test.ts",
    "test:e2e": "playwright test",
    "start": "node src/server/main.ts",
    "open:owner": "node scripts/open-owner.ts",
    "mcp": "node scripts/run-mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "occt-import-js": "0.0.23",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
